{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"allowJs": true,
		"checkJs": true,
		"strict": false,
		"skipLibCheck": true,
		"maxNodeModuleJsDepth": 0,
		"noUncheckedSideEffectImports": false,
		"types": ["vite/client"],
		"jsx": "react-jsx",
		"jsxImportSource": "preact"
	},
	"include": ["src/**/*", "test/**/*", "vite.config.js", "eslint.config.js"],
	"exclude": ["node_modules", "dist", "coverage", "dev-dist"]
}
